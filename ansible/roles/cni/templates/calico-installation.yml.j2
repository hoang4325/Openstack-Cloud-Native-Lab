---
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default

spec:
  calicoNetwork:

    bgp: Disabled

    nodeAddressAutodetectionV4:
      interface: "^{{ calico_node_interface }}$"

    ipPools:
      - blockSize: 26
        cidr: "{{ pod_network_cidr }}"
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()