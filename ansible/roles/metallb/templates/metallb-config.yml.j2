---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: lab-pool
  namespace: {{ metallb_namespace }}

spec:
  addresses:
{% for address in metallb_address_pool %}
    - {{ address }}
{% endfor %}

---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: lab-l2
  namespace: {{ metallb_namespace }}

spec:
  ipAddressPools:
    - lab-pool